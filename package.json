{
  "name": "dsh-openwiki",
  "version": "2.0.5",
  "description": "openwiki 知识库：DSH 内嵌代码库 Wiki 生成与阅读（复用 DSH 模型、运行时托管、生成/更新任务、知识卡片）。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "openwiki",
    "wiki",
    "knowledge"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/D2Moqi/dsh-openwiki.git"
  },
  "homepage": "https://github.com/D2Moqi/dsh-openwiki",
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs",
    "prepack": "node scripts/sync-version.mjs --check && npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "src",
    "screenshots",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ]
}
