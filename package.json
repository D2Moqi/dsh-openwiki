{
  "name": "dsh-openwiki",
  "version": "0.1.5",
  "description": "openwiki 知识库：DSH 内嵌代码库 Wiki 生成与阅读（复用 DSH 模型、运行时托管、生成/更新任务、知识卡片）。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": ["deepseek", "harness", "dsh", "dsh-plugin", "openwiki", "wiki", "knowledge"],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/d2moqi/dsh-openwiki.git"
  },
  "homepage": "https://gitee.com/d2moqi/dsh-openwiki",
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "src",
    "screenshots",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ]
}
